# Dois arquivos, mesmas chaves:
#   .env        -> PRODUÇÃO. Vai dentro do ZIP da Hostinger.
#   .env.local  -> DEV. Nunca vai no ZIP; quando existe, vence o .env — no Next
#                  e também no Prisma (prisma.config.ts) e no seed.
# Basta pôr no .env.local o que muda em dev, em geral só a DATABASE_URL.

# Banco MySQL. Caracteres especiais da senha vão codificados:
# # vira %23, @ vira %40, : vira %3A, / vira %2F.
DATABASE_URL="mysql://usuario:senha@localhost:3306/rrfilm"

# Segredo de assinatura dos cookies de sessão do painel (HS256).
# Gere um novo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Conta criada pelo `npm run db:seed` quando ainda não existe nenhum admin.
ADMIN_SEED_NOME="Equipe RR Film"
ADMIN_SEED_EMAIL="contato@rrfilm.com.br"
ADMIN_SEED_SENHA=""

# hCaptcha do login (https://dashboard.hcaptcha.com).
# As chaves abaixo são as de teste oficiais do hCaptcha: o widget sempre
# valida. Servem para desenvolver — TROQUE pelas chaves reais em produção.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY="10000000-ffff-ffff-ffff-000000000001"
HCAPTCHA_SECRET_KEY="0x0000000000000000000000000000000000000000"

# Google Tag Manager (tagmanager.google.com) — a única tag do site. GA4, Pixel
# da Meta e Google Ads são configurados DENTRO do contêiner, pela agência; o
# site não carrega nenhum deles direto. Só no site público, só no build de
# produção e só depois do aceite no aviso de cookies.
NEXT_PUBLIC_GTM_ID="GTM-WCC5478W"

# Aviso por e-mail de pedido de orçamento novo, pela caixa de e-mail da RR Film.
# Na Hostinger: smtp.hostinger.com, porta 465, usuário = o endereço completo.
# Sem isso o pedido é salvo do mesmo jeito e aparece em /admin/pedidos.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORTA="465"
SMTP_USUARIO="contato@rrfilm.com.br"
SMTP_SENHA=""
# Quem recebe o aviso. Vazio: o e-mail de contato cadastrado em /admin/conteudo.
PEDIDOS_EMAIL_PARA="contato@rrfilm.com.br"
